<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="farmax_ganamax_ticket">
        <t t-call="web.html_container">
            <style>
                html, body, #wrapwrap, main, .container, .container-fluid {
                    margin: 0 !important;
                    padding: 0 !important;
                    max-width: 100% !important;
                    width: 100% !important;
                }
                .farmax-ticket {
                    box-sizing: border-box;
                    width: 100%;
                    font-family: 'DejaVu Sans', sans-serif;
                    color: #000;
                }
                .farmax-box {
                    box-sizing: border-box;
                    width: 100%;
                    border: 1px solid #000;
                    padding: 12mm 3mm;
                }
                .farmax-ticket table { width: 100%; font-size: 10px; line-height: 1.35; }
                .farmax-ticket td.lbl { font-weight: bold; white-space: nowrap; }
                .farmax-ticket td.val { text-align: right; }
                .farmax-head {
                    text-align: center; font-weight: bold; font-size: 13px;
                    text-transform: uppercase;
                    border-bottom: 1px dashed #000;
                    padding-bottom: 3px; margin-bottom: 5px;
                }
                .farmax-foot {
                    text-align: center; font-size: 8px;
                    border-top: 1px dashed #000;
                    padding-top: 3px; margin-top: 5px;
                }
            </style>
            <t t-foreach="docs" t-as="doc">
                <t t-set="data" t-value="doc.farmax_partner_data()"/>
                <t t-foreach="doc.farmax_ticket_range()" t-as="ticket_i">
                    <div t-attf-class="page farmax-ticket"
                         t-attf-style="{{ '' if ticket_i_first else 'page-break-before:always;' }}">
                        <div class="farmax-box">
                            <div class="farmax-head">CON FARMAX GANA MAX</div>
                            <table>
                                <tr>
                                    <td class="lbl">NOMBRE</td>
                                    <td class="val"><span t-esc="data['firstname']"/></td>
                                </tr>
                                <tr>
                                    <td class="lbl">APELLIDO</td>
                                    <td class="val"><span t-esc="data['lastname']"/></td>
                                </tr>
                                <tr>
                                    <td class="lbl">CEDULA</td>
                                    <td class="val"><span t-esc="data['vat']"/></td>
                                </tr>
                                <tr>
                                    <td class="lbl">TELEFONO</td>
                                    <td class="val"><span t-esc="data['phone']"/></td>
                                </tr>
                                <tr>
                                    <td class="lbl">FACTURA</td>
                                    <td class="val"><span t-esc="data['invoice_number']"/></td>
                                </tr>
                            </table>
                            <div class="farmax-foot">
                                Ticket <span t-esc="ticket_i"/> de <span t-esc="doc.farmax_ticket_count()"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
